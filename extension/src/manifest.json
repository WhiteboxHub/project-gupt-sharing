{
  "manifest_version": 3,
  "name": "Gupt Service",
  "version": "1.0",
  "description": "Peer to peer screen sharing and remote interaction using WebRTC.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "desktopCapture"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gupt Service"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "panic_kill": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Kill WebRTC Stream"
    }
  }
}
